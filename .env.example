# YAAM local development environment template.
# Copy to `.env` and fill real values locally. Never commit `.env`.

# ---------------------------------------------------------------------------
# Storage backends
# ---------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mas_memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/mas_memory

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334

NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://localhost:7687
NEO4J_BOLT=bolt://localhost:7687
NEO4J_HTTP=http://localhost:7474

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_URL=http://localhost:8108

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

PHOENIX_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_GRPC_URL=http://localhost:4317
PHOENIX_PROJECT_NAME=yaam-local

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy3-preview
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=4096

GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Runtime flags
# ---------------------------------------------------------------------------

MAS_V2_MODE=true
